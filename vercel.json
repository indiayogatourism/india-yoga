{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "indiayogatourism.com"
        }
      ],
      "destination": "https://www.indiayogatourism.com/$1",
      "statusCode": 301
    }
  ]
}
