datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PackageCategory {
  RETREAT
  PROGRAMME
  ONLINE_CLASS
  TEACHER_TRAINING
  TREK
}

enum PackageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  email     String    @unique
  name      String
  phone     String?
  country   String?
  role      String    @default("guest")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
  reviews   Review[]
  onlineEnrolments OnlineClassEnrolment[]
}

model Package {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  shortDescription String
  description      String          @db.Text
  category         PackageCategory
  location         String
  locationTag      String
  durationDays     Int
  durationNights   Int
  maxGroupSize     Int             @default(12)
  difficultyLevel  String          @default("Beginner")

  // Pricing (USD)
  priceShared      Float
  pricePrivate     Float
  originalPrice    Float?

  // Content
  highlights       String[]
  inclusions       String[]
  exclusions       String[]
  itinerary        Json        // [{day:1, title:"", activities:[""]}]

  // Media (S3 keys)
  featuredImage    String?
  gallery          String[]

  // Badges
  isBestseller     Boolean     @default(false)
  isLimitedSpots   Boolean     @default(false)
  isRecommended    Boolean     @default(false)
  isNew            Boolean     @default(false)
  spotsLeft        Int?

  // SEO
  metaTitle        String?
  metaDescription  String?  @db.Text
  metaKeywords     String?
  canonicalUrl     String?
  ogTitle          String?
  ogDescription    String?  @db.Text
  ogImage          String?
  customHtmlTags   String?  @db.Text

  // Status + Stats
  status           PackageStatus   @default(DRAFT)
  totalBookings    Int             @default(0)
  avgRating        Float           @default(0)
  totalReviews     Int             @default(0)

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  bookings         Booking[]
  reviews          Review[]
}

model Booking {
  id            String        @id @default(cuid())
  bookingRef    String        @unique  // IYT-2026-00001
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  packageId     String
  package       Package       @relation(fields: [packageId], references: [id])

  // Trip details
  arrivalDate   DateTime
  departureDate DateTime
  guests        Int           @default(1)
  roomType      String        @default("shared")

  // Guest info
  fullName      String
  email         String
  phone         String
  country       String
  passportNumber String?
  dietaryReqs   String?
  medicalInfo   String?
  specialRequests String?
  hearAboutUs   String?

  // Pricing
  pricePerPerson Float
  totalAmount    Float
  currency       String        @default("USD")

  // Status
  status         BookingStatus @default(PENDING)

  // Generated docs (S3 keys)
  voucherUrl     String?
  receiptUrl     String?

  // Admin
  adminNote      String?
  confirmedAt    DateTime?

  payment        Payment?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Payment {
  id                  String        @id @default(cuid())
  bookingId           String        @unique
  booking             Booking       @relation(fields: [bookingId], references: [id])

  // Razorpay
  razorpayOrderId     String?       @unique
  razorpayPaymentId   String?
  razorpaySignature   String?

  // PayPal
  paypalOrderId       String?
  paypalPaymentId     String?

  amount              Float
  currency            String        @default("USD")
  status              PaymentStatus @default(PENDING)
  method              String?       // razorpay | paypal | bank_transfer
  paidAt              DateTime?
  createdAt           DateTime      @default(now())
}

model Review {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  packageId   String
  package     Package  @relation(fields: [packageId], references: [id])
  rating      Int
  title       String?
  content     String   @db.Text
  country     String?
  isVerified  Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  country   String?
  packageId String?
  message   String   @db.Text
  source    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SeoMeta {
  id          String   @id @default(cuid())
  pageKey     String   @unique
  title       String
  description String
  keywords    String?
  ogImage     String?
  updatedAt   DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String   @db.Text
  content         String   @db.Text
  coverImage      String?
  authorName      String   @default("India Yoga Tourism Team")
  category        String   @default("Ayurveda & Wellness")
  tags            String[]
  metaTitle       String?
  metaDescription String?  @db.Text
  metaKeywords    String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?  @db.Text
  ogImage         String?
  customHtmlTags  String?  @db.Text
  published       Boolean  @default(true)
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         String   @db.Text
  metaTitle       String?
  metaDescription String?  @db.Text
  metaKeywords    String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?  @db.Text
  ogImage         String?
  customHtmlTags  String?  @db.Text
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GalleryImage {
  id          String   @id @default(cuid())
  title       String
  category    String   @default("retreats") // retreats | activities | food
  url         String
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OnlineClass {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String   @db.Text
  timeSlot        String   @default("07:00 AM - 08:15 AM IST")
  level           String   @default("Beginner to Intermediate")
  instructor      String   @default("Yogini Arundhati")
  meetingUrl      String?  // Live stream join link for enrolled users (e.g. Zoom / Meet)
  price           Float    @default(49)
  coverImage      String?

  // SEO
  metaTitle       String?
  metaDescription String?  @db.Text
  metaKeywords    String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?  @db.Text
  ogImage         String?
  customHtmlTags  String?  @db.Text

  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  enrolments      OnlineClassEnrolment[]
}

model OnlineClassEnrolment {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  classId       String
  onlineClass   OnlineClass @relation(fields: [classId], references: [id])
  status        String      @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED
  createdAt     DateTime    @default(now())
}



